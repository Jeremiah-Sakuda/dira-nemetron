{
  "name": "dira",
  "private": true,
  "version": "0.1.0",
  "description": "Dira — the self-healing operating system for your commitments. One thing changes. Everything adapts.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "adapters/*",
    "agents/*",
    "services/*",
    "apps/*",
    "fixtures"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit packages",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property",
    "test:chaos": "vitest run tests/chaos",
    "test:replay": "vitest run tests/replay",
    "demo:replay": "tsx scripts/replay.ts",
    "demo:replay:20x": "tsx scripts/replay-20x.ts",
    "demo:variations": "tsx scripts/replay.ts --matrix",
    "eval:gemini": "tsx scripts/gemini-eval.ts",
    "eval:nemotron": "tsx scripts/nemotron-eval.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20"
  }
}
