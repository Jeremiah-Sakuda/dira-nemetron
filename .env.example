# Local/default evidence runtime
REPLAY_MODE=deterministic

# Web-to-Cloud Run server proxy (never prefix the token with NEXT_PUBLIC_)
DIRA_CLOUD_RUN_URL=https://dira-orchestrator-PROJECT.REGION.run.app
DIRA_DEMO_TOKEN=replace-with-a-long-random-secret

# Google Cloud provisioning and deployment
DIRA_PROJECT=your-dedicated-dira-project
DIRA_REGION=us-central1
DIRA_ALLOWED_ORIGIN=https://your-dashboard.example
DIRA_WEB_ORIGIN=https://your-dashboard.example
DIRA_SHARE_CALENDAR_WITH=optional-demo-viewer@example.com

# Per-account Google sign-in and PostgreSQL persistence for Dira v2.
DATABASE_URL=postgresql://dira_app:replace-me@localhost:5432/dira
DIRA_DATABASE_SSL=false
DIRA_SESSION_SECRET=replace-with-at-least-32-random-bytes-here
# Base64 encoding of a random 32-byte key; use a secret manager in deployment.
DIRA_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the web callback route registered in Google OAuth settings.
GOOGLE_REDIRECT_URI=https://your-dashboard.example/api/auth/google/callback
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-dedicated-dira-project
GOOGLE_CLOUD_LOCATION=us-central1

# Live interpretation uses Nemotron through Nebius Token Factory.
NEBIUS_API_KEY=
DIRA_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
DIRA_NEMOTRON_NANO_MODEL=nvidia/nemotron-3-nano-30b-a3b
DIRA_NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Legacy v1 Gemini eval only; not used by the v2 runtime path.
GEMINI_API_KEY=

# Optional Gemma 3n voice-note intake. The orchestrator sends audio to this
# private GPU service; it receives only a transcript and applies all normal
# Dira authority, policy, provenance, and verification gates afterwards.
DIRA_GEMMA3N_URL=https://dira-gemma-voice-PROJECT.REGION.run.app
DIRA_GEMMA3N_TOKEN=replace-with-a-separate-long-random-secret
# Server-only Hugging Face token from an account that accepted Gemma terms.
HF_TOKEN=
