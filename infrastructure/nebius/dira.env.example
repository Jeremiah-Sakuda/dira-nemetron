# Copy to dira.env on the VM (chmod 600). Never commit dira.env.
POSTGRES_SUPERUSER_PASSWORD=replace-me
DIRA_APP_DB_PASSWORD=replace-me
DIRA_WEB_DOMAIN=dira.example.com
DIRA_API_DOMAIN=api.dira.example.com
DIRA_WEB_ORIGIN=https://dira.example.com
DIRA_PUBLIC_ORCHESTRATOR_URL=https://api.dira.example.com
DIRA_SESSION_SECRET=replace-with-64-hex-chars
DIRA_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dira.example.com/api/auth/google/callback
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Optional Telegram approvals bot (separate from the Hermes chat bot).
DIRA_TELEGRAM_BOT_TOKEN=
DIRA_TELEGRAM_BOT_USERNAME=
DIRA_TELEGRAM_WEBHOOK_SECRET=
# Background work, per trusted account id (comma-separated).
DIRA_CALENDAR_SYNC_ACCOUNT_IDS=
DIRA_GMAIL_SYNC_ACCOUNT_IDS=
DIRA_ICAL_SYNC_ACCOUNT_IDS=
DIRA_DAILY_JOB_ACCOUNT_IDS=
